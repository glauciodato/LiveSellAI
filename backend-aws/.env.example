# Copie este arquivo para .env (gitignored) e preencha pra rodar localmente.

PORT=8080
CORS_ALLOWED_ORIGIN=*

PGHOST=<endpoint-do-rds, sem a porta>
PGPORT=5432
PGDATABASE=livesellai
PGUSER=livesellai_admin
PGPASSWORD=<senha do RDS -- pegue com "terraform output -raw db_password" dentro de infra-aws-app/>

AWS_REGION=us-east-1
S3_BUCKET_NAME=<nome do bucket -- "terraform output -raw bucket_name" dentro de infra-aws-app/>

UPLOAD_URL_EXPIRY_MINUTES=15
READ_URL_EXPIRY_MINUTES=60

# Client ID do OAuth do Google (tipo Web, Google Cloud Console) -- usado
# pra validar o ID token que o frontend manda em POST /api/auth/google.
# Não é segredo, mas sem isso o endpoint responde 500.
GOOGLE_CLIENT_ID=

# Credenciais da AWS pra rodar local (o SDK já lê essas variáveis de
# ambiente automaticamente, ou pode usar `aws configure`/SSO em vez disso
# -- rodando dentro do ECS, não precisa de nada disso, a Task Role já
# resolve sozinha).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
